{
  "permissions": {
    "allow": [
      "Bash(rm src/App.css)",
      "Bash(npm run:*)",
      "Bash(npx tsc *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(npm install *)",
      "Bash(npx shadcn@latest init --defaults --yes)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(npx shadcn@latest add badge card dialog input label tooltip --yes)",
      "Bash(Get-ChildItem -Recurse \"C:\\\\workspaces\\\\intellij\\\\stock-valuator-ui\\\\.claude\\\\skills\")",
      "Bash(Select-Object FullName)",
      "Read(//dev/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); f=d.get(\\\"file_path\\\",\\\"\\\"); print(f)\" | grep -E \"\\.(tsx|ts)$\" && npm run lint --silent 2>&1 | head -30 || true'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"✅ Claude terminó la tarea\""
          }
        ]
      }
    ]
  }
}
